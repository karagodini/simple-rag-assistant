# Папка индекса FAISS
RAG_INDEX_DIR=.rag_index

# tfidf — без сети. sbert — sentence-transformers, нужен requirements-optional.txt
RAG_EMBEDDER=tfidf
RAG_SBERT_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Нарезка текста: длина фрагмента и перекрытие, в символах
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# Сколько фрагментов брать в ответ и какой порог косинусной схожести
RAG_TOP_K=4
RAG_MIN_SCORE=0.25

# OpenAI-совместимый провайдер. Пустой ключ включает экстрактивный фолбэк:
# ответ собирается из найденных фрагментов, без генерации.
#
# OpenRouter:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-...
# OPENAI_MODEL=openai/gpt-4o-mini
#
# Groq:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_...
# OPENAI_MODEL=llama-3.3-70b-versatile
#
# Локальная Ollama. Ключ может быть любым непустым, иначе сработает фолбэк:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.1

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
